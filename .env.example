# ===== Sao chép thành .env rồi điền giá trị thật (KHÔNG commit .env lên GitHub) =====
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Địa chỉ website (dùng cho SEO, sitemap, link trong email)
SITE_URL=https://thuydienmuongkim.vn

# Chuỗi bí mật ký cookie phiên đăng nhập — tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Tài khoản quản trị tạo ở lần chạy đầu tiên (đổi mật khẩu sau khi đăng nhập)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Thư mục dữ liệu (CSDL SQLite) và tệp tải lên — nằm ngoài Git
DATA_DIR=data
UPLOAD_DIR=uploads

# ===== Gửi email thông báo (SMTP) =====
# Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
# Email doanh nghiệp Hostinger: smtp.hostinger.com, cổng 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Website Thủy điện Mường Kim <muongkimhp.jsc@gmail.com>"
# Email nhận thông báo tin nhắn/hồ sơ (nhiều địa chỉ cách nhau bởi dấu phẩy)
MAIL_TO=muongkimhp.jsc@gmail.com
