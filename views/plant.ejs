<%- include('partials/head') %>
<%
  const L = t('locale');
  const vi = lang === 'vi';
  const mk2 = t('plant.mk2');
  // Ảnh đại diện và dòng tóm tắt của từng nhà máy (nhà máy chưa có thông tin hiển thị "đang cập nhật")
  const cover = { 'muong-kim': '/media/plant/plant-03', 'muong-kim-2': '/media/plant-mk2/plant-mk2-01' };
  const summary = {
    'muong-kim': `${h.formatNumber(settings.capacity_mw, L)} MW · ${settings.units} ${t('common.units')} · ${vi ? 'vận hành từ' : 'in operation since'} ${settings.year_operation}`,
    'muong-kim-2': `${mk2.specs[0].value} · ${mk2.specs[1].value}`,
  };
%>
<%- include('partials/page-hero', { heroTitle: t('plant.overviewTitle'), heroLead: t('plant.overviewLead'), crumbs: [{ label: t('nav.plant') }] }) %>

<section class="section plants" aria-labelledby="plants-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow"><%= t('plant.plantsTitle') %></p>
      <h2 class="section-title" id="plants-title"><%= t('plant.plantsHeading') %></h2>
    </div>
    <ul class="plant-list">
      <% t('plant.plants').forEach((p, i) => { %>
        <li>
          <a class="plant-card reveal<%= cover[p.id] ? ' plant-card--photo' : '' %>" href="<%= url('plant', p.id) %>">
            <% if (cover[p.id]) { %><span class="plant-card__media"><%- h.img(cover[p.id], '', { sizes: '(min-width: 1024px) 300px, (min-width: 561px) 50vw, 100vw', width: 640 }) %></span><% } %>
            <span class="plant-card__body">
              <span class="plant-card__num"><%= String(i + 1).padStart(2, '0') %></span>
              <span class="plant-card__name"><%= p.name %></span>
              <span class="plant-card__text<%= summary[p.id] ? '' : ' muted' %>"><%= summary[p.id] || t('plant.plantsPending') %></span>
              <span class="link-arrow"><%= t('common.readMore') %> <%- icon('arrow-right') %></span>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<%- include('partials/foot') %>
