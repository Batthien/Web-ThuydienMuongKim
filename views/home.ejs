<%- include('partials/head') %>
<% const L = t('locale'); %>
<%# Đầu trang chủ chỉ chạy ảnh; tiêu đề giữ lại cho trình đọc màn hình và SEO %>
<section class="hero hero--bare">
  <%- include('partials/hero-slides', { mediaCls: 'hero__media' }) %>
  <h1 class="sr-only"><%= t('home.heroTitle') %></h1>
</section>

<%# Dải chữ chạy: nội dung sửa trong Quản trị → Cấu hình %>
<% const tickerItems = String(settings['ticker_' + lang] || settings.ticker_vi || '').split(/\r?\n/).map((x) => x.trim()).filter(Boolean); %>
<% if (tickerItems.length) { %>
<section class="ticker" aria-label="<%= lang === 'en' ? 'Our companies' : 'Các công ty' %>">
  <div class="ticker__track">
    <% for (let copy = 0; copy < 2; copy++) { %>
    <ul class="ticker__list"<%- copy ? ' aria-hidden="true"' : '' %>>
      <% for (let r = 0; r < 2; r++) for (const item of tickerItems) { %>
      <li class="ticker__item"><span class="ticker__dot" aria-hidden="true"></span><%= item %></li>
      <% } %>
    </ul>
    <% } %>
  </div>
</section>
<% } %>

<%- include('partials/spotlight') %>

<%# Bảng thống kê SXKD ngày: số liệu nhập trong Quản trị → Báo cáo SXKD ngày; xem lại ngày trước bằng ?date= %>
<section class="section daily" id="sxkd-ngay" data-daily>
<%- include('partials/daily') %>
</section>

<section class="section about-intro">
  <div class="container split">
    <div class="split__media collage reveal">
      <div class="collage__main"><%- h.img('/media/plant/plant-03', lang === 'vi' ? 'Nhà máy Thủy điện Mường Kim' : 'Muong Kim Hydropower Plant', { sizes: '(min-width: 1024px) 560px, 100vw' }) %></div>
      <div class="collage__sub"><%- h.img('/media/anniversary/anniversary-06', lang === 'vi' ? 'Bánh xe công tác tua-bin Francis trưng bày tại khuôn viên nhà máy' : 'Francis turbine runner on display at the plant', { sizes: '260px', width: 640 }) %></div>
      <div class="collage__badge" aria-hidden="true"><strong>10+</strong><span><%= lang === 'vi' ? 'năm vận hành' : 'years of operation' %></span></div>
    </div>
    <div class="split__text reveal">
      <p class="eyebrow"><%= t('home.aboutEyebrow') %></p>
      <h2 class="section-title"><%= t('home.aboutTitle') %></h2>
      <p class="lead"><%= t('home.aboutText') %></p>
      <ol class="mini-timeline">
        <% t('about.timeline').forEach((m) => { %><li><span class="mini-timeline__year"><%= m.year %></span><div><strong><%= m.title %></strong><span><%= m.text %></span></div></li><% }) %>
      </ol>
      <a class="btn btn--primary" href="<%= url('about') %>#history"><span><%= t('home.aboutMore') %></span><%- icon('arrow-right') %></a>
    </div>
  </div>

  <%# 3 công ty còn lại: nội dung sửa trong Quản trị → Cấu hình %>
  <div class="container sister">
    <div class="sister__head reveal">
      <p class="eyebrow"><%= t('home.sisterEyebrow') %></p>
      <h3 class="sister__title"><%= t('home.sisterTitle') %></h3>
    </div>
    <div class="sister__grid">
      <% const plantIds = t('plant.plants').map((p) => p.id);
         ['tu', 'pl', 'nk'].forEach((code, i) => { const co = COMPANIES.find((c) => c.code === code);
           const intro = settings['co_' + code + '_intro_' + lang] || settings['co_' + code + '_intro_vi'] || '';
           const plant = plantIds.includes(settings['co_' + code + '_plant']) ? settings['co_' + code + '_plant'] : '';
           const photo = { 'muong-kim': '/media/plant/plant-03', 'muong-kim-2': '/media/plant-mk2/plant-mk2-01', 'phieng-luc': '/media/plant-pl/plant-pl-01', 'ho-bon-2': '/media/plant-hb2/plant-hb2-01' }[plant] || '/media/dam/dam-02'; %>
        <article class="sister-card reveal" style="--i:<%= i %>">
          <div class="sister-card__media" aria-hidden="true"><%- h.img(photo, '', { sizes: '(min-width: 960px) 420px, 100vw', width: 640 }) %></div>
          <div class="sister-card__body">
            <span class="sister-card__icon"><%- icon('zap') %></span>
            <h4><%= lang === 'en' ? co.en : co.vi %></h4>
            <p><%= intro %></p>
            <div class="sister-card__links">
              <% if (plant) { %><a href="<%= url('plant', plant) %>"><span><%= t('home.sisterPlant') %></span><%- icon('arrow-right') %></a><% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section pillars">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow"><%= t('home.pillarsEyebrow') %></p>
      <h2 class="section-title"><%= t('home.pillarsTitle') %></h2>
    </div>
    <div class="card-grid card-grid--4">
      <% t('home.pillars').forEach((p) => { %>
        <article class="feature-card reveal">
          <span class="feature-card__icon"><%- icon(p.icon) %></span>
          <h3><%= p.title %></h3>
          <p><%= p.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section ir-band">
  <div class="container split split--top">
    <div class="split__text reveal">
      <p class="eyebrow"><%= t('home.irEyebrow') %></p>
      <h2 class="section-title"><%= t('home.irTitle') %></h2>
      <p class="lead"><%= t('home.irText') %></p>
      <a class="btn btn--primary" href="<%= url('ir') %>"><span><%= t('nav.ir') %></span><%- icon('arrow-right') %></a>
    </div>
    <div class="reveal">
      <% if (docs.length) { %>
        <ul class="doc-list">
          <% docs.forEach((d) => { %>
            <li class="doc-item">
              <span class="doc-item__icon"><%- icon('file') %></span>
              <div class="doc-item__body">
                <a class="doc-item__title" href="/uploads/docs/<%= d.file %>" target="_blank" rel="noopener"><%= loc(d, 'title') %></a>
                <p class="doc-item__meta"><%= t('ir.categories.' + d.category) %> · <time datetime="<%= d.published_at %>"><%= h.formatDate(d.published_at, L) %></time></p>
              </div>
              <a class="icon-btn" href="/uploads/docs/<%= d.file %>" download aria-label="<%= t('common.download') %>: <%= loc(d, 'title') %>"><%- icon('download') %></a>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <ul class="ir-cats">
          <% IR_CATEGORIES.forEach((c) => { %>
            <li><a href="<%= url('ir') %>?cat=<%= c %>"><%- icon('file') %><span><%= t('ir.categories.' + c) %></span><%- icon('chevron-right') %></a></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
