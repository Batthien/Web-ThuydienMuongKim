<%# locals: heroTitle, heroLead, crumbs [{label, href}], bare (chỉ chạy ảnh, chữ ẩn cho SEO), below (ảnh không chữ, tiêu đề hiện ở dưới ảnh) %>
<% const below = !locals.bare && locals.below !== false; /* mặc định: ảnh không chữ, tiêu đề dưới ảnh */ const plain = locals.bare || below; %>
<section class="page-hero<%= plain ? ' page-hero--bare' : '' %>">
  <%- include('hero-slides', { mediaCls: 'page-hero__media' }) %>
  <% if (!below) { %>
  <div class="container page-hero__content<%= locals.bare ? ' sr-only' : '' %>">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="<%= url('home') %>"><%= t('common.home') %></a></li>
        <% (locals.crumbs || []).forEach((c, i, arr) => { %>
          <li><% if (c.href && i < arr.length - 1) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span aria-current="page"><%= c.label %></span><% } %></li>
        <% }) %>
      </ol>
    </nav>
    <h1 class="page-hero__title"><%= heroTitle %></h1>
    <% if (locals.heroLead) { %><p class="page-hero__lead"><%= heroLead %></p><% } %>
  </div>
  <% } %>
</section>
<% if (below) { %>
<div class="page-intro">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="<%= url('home') %>"><%= t('common.home') %></a></li>
        <% (locals.crumbs || []).forEach((c, i, arr) => { %>
          <li><% if (c.href && i < arr.length - 1) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span aria-current="page"><%= c.label %></span><% } %></li>
        <% }) %>
      </ol>
    </nav>
    <h1 class="page-intro__title"><%= heroTitle %></h1>
    <% if (locals.heroLead) { %><p class="page-intro__lead"><%= heroLead %></p><% } %>
  </div>
</div>
<% } %>
