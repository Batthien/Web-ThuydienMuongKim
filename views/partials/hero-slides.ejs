<%# Trình chiếu ảnh đầu trang: ảnh trong album "hero" (thư mục ANH DEP). locals: mediaCls ('hero__media' | 'page-hero__media') %>
<%
  const heroAlbum = h.gallery.filter((g) => g.album === 'hero').map((g) => g.src);
  const slides = heroAlbum.length ? heroAlbum : [
    '/media/dam/dam-01', '/media/plant/plant-03', '/media/dam/dam-02',
    '/media/plant/plant-04', '/media/plant/plant-01', '/media/plant/plant-02',
  ];
%>
<div class="<%= mediaCls %> hero-slides" data-slides aria-hidden="true">
  <% slides.forEach((s, i) => { %>
    <%- h.img(s, '', { sizes: '100vw', eager: i === 0, defer: i > 0, cls: 'hero-slides__img' + (i === 0 ? ' is-active' : '') }) %>
  <% }) %>
</div>
