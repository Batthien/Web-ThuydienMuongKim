<%# Bảng thống kê SXKD ngày (trang chủ). fragment = true khi tải lại riêng khối này bằng JS (xem ngày khác) %>
<% const L = t('locale'); const fragment = locals.fragment || false; %>
<% const D = t('home.daily'); const num = (x, d) => (x == null ? '—' : h.formatNumber(d == null ? Math.round(x) : x, L, d)); %>
  <div class="container">
    <div class="section-head section-head--row<%= fragment ? '' : ' reveal' %>">
      <div>
        <p class="eyebrow"><%= D.eyebrow %></p>
        <h2 class="section-title"><%= D.title %></h2>
      </div>
      <% if (daily.date) { const link = (d) => url('home') + '?date=' + d + '#sxkd-ngay'; %>
      <form class="daily__nav" method="get" action="<%= url('home') %>#sxkd-ngay" data-daily-form>
        <% if (daily.prev) { %><a class="daily__step" href="<%= link(daily.prev) %>" data-daily-date="<%= daily.prev %>" aria-label="<%= D.prev %>" title="<%= D.prev %>"><%- icon('chevron-left') %></a><% } else { %><span class="daily__step is-disabled" aria-hidden="true"><%- icon('chevron-left') %></span><% } %>
        <label class="daily__pick"><%- icon('calendar') %><span class="sr-only"><%= D.pick %></span><input type="date" name="date" value="<%= daily.date %>" min="<%= daily.first %>" max="<%= daily.latest %>" required></label>
        <button class="daily__go" type="submit"><%= D.go %></button>
        <% if (daily.next) { %><a class="daily__step" href="<%= link(daily.next) %>" data-daily-date="<%= daily.next %>" aria-label="<%= D.next %>" title="<%= D.next %>"><%- icon('chevron-right') %></a><% } else { %><span class="daily__step is-disabled" aria-hidden="true"><%- icon('chevron-right') %></span><% } %>
        <% if (daily.date !== daily.latest) { %><a class="daily__latest" href="<%= url('home') %>#sxkd-ngay" data-daily-date=""><%= D.latest %></a><% } %>
      </form>
      <% } else { %>
      <p class="daily__date"><%- icon('calendar') %><span><%= D.pending %></span></p>
      <% } %>
    </div>
    <div class="daily__wrap<%= fragment ? '' : ' reveal' %>" tabindex="0" role="region" aria-label="<%= D.title %>">
      <table class="daily__table">
        <thead>
          <tr>
            <th scope="col"><%= D.cols.plant %></th>
            <th scope="col"><%= D.cols.mw %></th>
            <th scope="col"><%= D.cols.output %></th>
            <th scope="col"><%= D.cols.month %></th>
            <th scope="col"><%= D.cols.year %></th>
            <th scope="col"><%= D.cols.pct %></th>
            <th scope="col"><%= D.cols.revenue %></th>
            <th scope="col"><%= D.cols.level %></th>
            <th scope="col"><%= D.cols.inflow %></th>
          </tr>
        </thead>
        <tbody>
          <% daily.rows.forEach((r) => { %>
          <tr>
            <th scope="row"><%= lang === 'en' ? r.en : r.vi %></th>
            <td><%= num(r.mw, r.mw % 1 ? 1 : 0) %></td>
            <td><strong><%= num(r.output) %></strong></td>
            <td><%= num(r.month_output) %></td>
            <td><%= num(r.year_output) %></td>
            <td><% if (r.pct != null) { %><span class="daily__pct"><span style="--w:<%= Math.min(100, r.pct).toFixed(1) %>%"></span></span><%= num(r.pct, 1) %>%<% } else { %>—<% } %></td>
            <td><%= r.revenue == null ? '—' : num(r.revenue, 1) %></td>
            <td><%= r.water_level == null ? '—' : num(r.water_level, 2) %></td>
            <td><%= r.inflow == null ? '—' : num(r.inflow, 2) %></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row"><%= D.total %></th>
            <td><%= num(daily.total.mw, 1) %></td>
            <td><strong><%= num(daily.total.output) %></strong></td>
            <td><%= num(daily.total.month_output) %></td>
            <td><%= num(daily.total.year_output) %></td>
            <td><%= daily.total.pct == null ? '—' : num(daily.total.pct, 1) + '%' %></td>
            <td><%= daily.total.revenue == null ? '—' : num(daily.total.revenue, 1) %></td>
            <td></td><td></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="daily__note" role="status"><% if (daily.date) { %><strong><%= D.date %> <%= h.formatDate(daily.date, L) %>.</strong> <%= daily.hasDay ? '' : D.noDay + ' ' %><%= D.note %><% } else { %><%= D.pendingNote %><% } %></p>
  </div>
