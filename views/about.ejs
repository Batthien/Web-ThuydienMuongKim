<%- include('partials/head') %>
<%- include('partials/page-hero', { heroTitle: t('about.title'), heroLead: t('about.lead'), crumbs: [{ label: t('about.title') }], bare: true }) %>

<section class="section about-section" id="history" aria-labelledby="history-title">
  <div class="container split split--top">
    <div class="split__text reveal">
      <p class="eyebrow"><%= t('about.historyTitle') %></p>
      <h2 class="section-title" id="history-title"><%= t('about.historyHeading') %></h2>
      <% t('about.story').forEach((p) => { %><p><%= p %></p><% }) %>
    </div>
    <aside class="profile-card reveal" aria-labelledby="profile-title">
      <h2 id="profile-title" class="profile-card__title"><%= t('about.overviewTitle') %></h2>
      <dl class="profile-list">
        <div><dt><%= t('about.fields.name') %></dt><dd><%= settings.company_name_vi %></dd></div>
        <div><dt><%= t('about.fields.nameEn') %></dt><dd><%= settings.company_name_en %></dd></div>
        <div><dt><%= t('about.fields.tax') %></dt><dd><%= settings.tax_code %></dd></div>
        <div><dt><%= t('about.fields.rep') %></dt><dd><%= lang === 'vi' ? 'Ông ' : 'Mr. ' %><%= settings.director %> – <%= t('about.fields.repRole') %></dd></div>
        <div><dt><%= t('about.fields.address') %></dt><dd><%= lang === 'en' ? settings.address_en : settings.address_vi %></dd></div>
        <div><dt><%= t('about.fields.phone') %></dt><dd><a href="tel:<%= settings.phone.replace(/[^0-9+]/g, '') %>"><%= settings.phone %></a></dd></div>
        <div><dt><%= t('about.fields.email') %></dt><dd><a href="mailto:<%= settings.email %>"><%= settings.email %></a></dd></div>
      </dl>
    </aside>
  </div>
  <% if (plantsStrip.length) { %>
  <div class="container">
    <ul class="plant-strip">
      <% plantsStrip.forEach((p, i) => { %>
        <li class="plant-strip__item reveal" style="--i:<%= i %>">
          <%- h.img(p.src, p.plant, { sizes: '(min-width: 1024px) 300px, 50vw', width: 640 }) %>
          <span class="plant-strip__name"><%= p.plant %></span>
        </li>
      <% }) %>
    </ul>
  </div>
  <% } %>
</section>

<section class="section section--dark about-timeline" aria-label="<%= t('about.timelineTitle') %>">
  <div class="about-timeline__bg" aria-hidden="true"><%- h.img(timelineBg, '', { sizes: '100vw' }) %></div>
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow eyebrow--light"><%= t('about.timelineTitle') %></p>
      <h2 class="section-title"><%= lang === 'vi' ? 'Hành trình trưởng thành và phát triển' : 'A journey of growth and development' %></h2>
    </div>
    <ol class="timeline">
      <% t('about.timeline').forEach((m) => { %>
        <li class="timeline__item reveal">
          <span class="timeline__year"><%= m.year %></span>
          <div><h3><%= m.title %></h3><p><%= m.text %></p></div>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<% const org = t('about.org'); %>
<section class="section about-section" id="structure" aria-labelledby="structure-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow"><%= org.title %></p>
      <h2 class="section-title" id="structure-title"><%= org.heading %></h2>
      <p class="lead"><%= org.lead %></p>
    </div>
    <div class="org reveal">
      <% org.governance.forEach((g) => { %>
        <div class="org__node org__node--gov"><strong><%= g.name %></strong><span><%= g.note %></span></div>
        <span class="org__line" aria-hidden="true"></span>
      <% }) %>
      <div class="org__board">
        <p class="org__board-title"><%= org.boardTitle %></p>
        <ul class="org__people">
          <% org.board.forEach((b) => { %><li><span><%= b.role %></span><strong><%= b.person %></strong></li><% }) %>
        </ul>
      </div>
      <span class="org__line" aria-hidden="true"></span>
      <ul class="org__units">
        <% org.units.forEach((u) => { %>
          <li class="org__unit"><span class="org__icon"><%- icon(u.icon) %></span><strong><%= u.name %></strong><span><%= u.note %></span></li>
        <% }) %>
      </ul>
      <div class="org__union"><span class="org__icon"><%- icon('users') %></span><p><strong><%= org.union.name %></strong> · <%= org.union.note %></p></div>
    </div>
  </div>
</section>

<section class="section section--tint about-section" id="vision" aria-labelledby="vision-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow"><%= t('about.visionTitle') %></p>
      <h2 class="section-title" id="vision-title"><%= t('about.visionHeading') %></h2>
    </div>
    <% if (damRow.length) { %>
    <div class="photo-row" data-lightbox data-label-close="<%= t('gallery.close') %>" data-label-prev="<%= t('gallery.prev') %>" data-label-next="<%= t('gallery.next') %>">
      <% damRow.forEach((p) => { %>
        <a class="photo-row__item reveal" href="<%= h.imgUrl(p.src, 1920) %>" data-lightbox-item data-caption="<%= p.caption %>">
          <%- h.img(p.src, p.caption, { sizes: '(min-width: 1024px) 400px, 100vw', width: 640 }) %>
          <span class="photo-row__cap"><%= p.plant %></span>
        </a>
      <% }) %>
    </div>
    <% } %>
    <div class="vm-grid">
      <article class="vm-card reveal">
        <span class="vm-card__icon"><%- icon('growth') %></span>
        <h3><%= t('about.visionTitle') %></h3>
        <p><%= t('about.vision') %></p>
        <ul class="vm-card__chips"><% t('about.visionPoints').forEach((v) => { %><li><%- icon('check') %><%= v %></li><% }) %></ul>
      </article>
      <article class="vm-card vm-card--accent reveal">
        <span class="vm-card__icon"><%- icon('zap') %></span>
        <h3><%= t('about.missionTitle') %></h3>
        <p><%= t('about.mission') %></p>
      </article>
    </div>
  </div>
</section>

<section class="section about-section" id="philosophy" aria-labelledby="philosophy-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow"><%= t('about.philosophyTitle') %></p>
      <h2 class="section-title" id="philosophy-title"><span class="slogan">“<%= t('about.slogan') %>”</span></h2>
      <p class="lead"><%= t('about.philosophyText') %></p>
    </div>
    <h3 class="values-title reveal"><%= t('about.valuesTitle') %></h3>
    <div class="card-grid card-grid--4 values">
      <% t('about.values').forEach((v, i) => { %>
        <article class="value-card reveal">
          <span class="value-card__num"><%= String(i + 1).padStart(2, '0') %></span>
          <h3><%= v.title %></h3>
          <p><%= v.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<% if (gallery.length) { %>
<section class="section section--tint about-photos" aria-labelledby="about-photos-title">
  <div class="container">
    <div class="section-head section-head--row reveal">
      <div>
        <p class="eyebrow"><%= t('nav.gallery') %></p>
        <h2 class="section-title" id="about-photos-title"><%= t('about.photosHeading') %></h2>
      </div>
      <a class="link-arrow" href="<%= url('gallery') %>"><%= t('common.viewAll') %> <%- icon('arrow-right') %></a>
    </div>
    <div class="mosaic" data-lightbox data-label-close="<%= t('gallery.close') %>" data-label-prev="<%= t('gallery.prev') %>" data-label-next="<%= t('gallery.next') %>">
      <% gallery.forEach((p, i) => { %>
        <a class="mosaic__item reveal" href="<%= h.imgUrl(p.src, 1920) %>" data-lightbox-item data-caption="<%= p.caption %>">
          <%- h.img(p.src, p.caption, { sizes: i === 0 ? '(min-width: 1024px) 600px, 100vw' : '(min-width: 1024px) 300px, 50vw', width: 640 }) %>
          <span class="mosaic__cap"><%= p.plant %></span>
          <span class="gallery-grid__zoom" aria-hidden="true"><%- icon('expand') %></span>
          <span class="sr-only"><%= t('gallery.open') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/foot') %>
