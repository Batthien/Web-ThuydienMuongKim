<%- include('partials/head') %>
<%
  const L = t('locale');
  const vi = lang === 'vi';
  const id = plant.id;
  const d = plant.detail ? t('plant.' + plant.detail) : null; // nội dung chi tiết (Mường Kim II, Phiêng Lúc...)
  // Dòng dưới tiêu đề: tóm tắt ngắn, không lặp lại đoạn giới thiệu bên dưới
  const heroLead = id === 'muong-kim' ? t('plant.lead') : d ? `${d.specs[0].value} · ${d.specs[1].value} · ${d.specs[4].value}` : t('plant.plantsPending');
%>
<%- include('partials/page-hero', { heroTitle: plant.name, heroLead, crumbs: [{ label: t('nav.plant'), href: url('plant') }, { label: plant.name }] }) %>
<%- include('partials/plant-tabs', { current: id }) %>

<% if (id === 'muong-kim') { %>
<%
  const specs = [
    ['gauge', t('plant.specs.capacity'), h.formatNumber(settings.capacity_mw, L) + ' MW'],
    ['cog', t('plant.specs.units'), settings.units + ' ' + t('common.units')],
    ['zap', t('plant.specs.turbine'), vi ? settings.turbine_vi : settings.turbine_en],
    ['growth', t('plant.specs.output'), h.formatNumber(settings.annual_output_kwh, L) + ' kWh/' + (vi ? 'năm' : 'year')],
    ['droplet', t('plant.specs.river'), vi ? settings.river_vi : settings.river_en],
    ['shield', t('plant.specs.dam'), vi ? settings.dam_vi : settings.dam_en],
    ['calendar', t('plant.specs.operation'), settings.year_operation],
    ['users', t('plant.specs.buyer'), vi ? settings.buyer_vi : settings.buyer_en],
    ['pin', t('plant.specs.location'), vi ? settings.address_vi : settings.address_en],
  ];
%>
<section class="section" id="thong-so">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow"><%= t('plant.specsTitle') %></p>
      <h2 class="section-title"><%= vi ? 'Công trình thủy điện trên suối Nậm Mu' : 'A hydropower scheme on the Nam Mu stream' %></h2>
    </div>
    <dl class="spec-grid">
      <% specs.forEach(([ic, label, value]) => { %>
        <div class="spec reveal">
          <span class="spec__icon"><%- icon(ic) %></span>
          <dt><%= label %></dt>
          <dd><%= value %></dd>
        </div>
      <% }) %>
    </dl>
  </div>
</section>

<section class="section section--tint">
  <div class="container split">
    <div class="split__media reveal">
      <div class="rounded-media"><%- h.img('/media/dam/dam-01', vi ? 'Đập tràn tự do xả lũ trên suối Nậm Mu' : 'Free-overflow spillway on the Nam Mu stream in flood', { sizes: '(min-width: 1024px) 560px, 100vw' }) %></div>
    </div>
    <div class="split__text reveal">
      <p class="eyebrow"><%= vi ? 'Công trình đầu mối' : 'Headworks' %></p>
      <h2 class="section-title"><%= t('plant.damTitle') %></h2>
      <p class="lead"><%= t('plant.damText') %></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container split split--reverse">
    <div class="split__media reveal">
      <div class="rounded-media"><%- h.img('/media/plant/plant-03', vi ? 'Nhà máy đặt 3 tổ máy Francis trục ngang' : 'Powerhouse with three horizontal Francis units', { sizes: '(min-width: 1024px) 560px, 100vw' }) %></div>
    </div>
    <div class="split__text reveal">
      <p class="eyebrow"><%= vi ? 'Nhà máy' : 'Powerhouse' %></p>
      <h2 class="section-title"><%= t('plant.houseTitle') %></h2>
      <p class="lead"><%= t('plant.houseText') %></p>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="container">
    <div class="section-head section-head--row reveal">
      <div>
        <p class="eyebrow"><%= t('nav.gallery') %></p>
        <h2 class="section-title"><%= t('plant.galleryTitle') %></h2>
      </div>
      <a class="link-arrow" href="<%= url('gallery') %>"><%= t('common.viewAll') %> <%- icon('arrow-right') %></a>
    </div>
    <div class="gallery-grid gallery-grid--masonry" data-lightbox data-label-close="<%= t('gallery.close') %>" data-label-prev="<%= t('gallery.prev') %>" data-label-next="<%= t('gallery.next') %>">
      <% photos.forEach((p) => { %>
        <a class="gallery-grid__item reveal" href="<%= h.imgUrl(p.src, 1920) %>" data-caption="<%= t('gallery.albums.' + p.album) %>">
          <%- h.img(p.src, t('gallery.albums.' + p.album), { sizes: '(min-width: 1024px) 400px, 50vw', width: 640 }) %>
          <span class="gallery-grid__zoom" aria-hidden="true"><%- icon('expand') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<% } else if (d) { %>
<section class="section plant-detail" aria-labelledby="detail-title">
  <div class="container">
    <div class="split split--top plant-detail__intro">
      <div class="split__text reveal">
        <p class="eyebrow"><%= d.eyebrow %></p>
        <h2 class="section-title" id="detail-title"><%= d.introTitle %></h2>
        <p class="lead"><%= d.lead %></p>
        <p><%= d.text %></p>
      </div>
      <% if (photos[0]) { %>
      <div class="split__media reveal">
        <div class="rounded-media"><%- h.img(photos[0].src, d.captions[0], { sizes: '(min-width: 1024px) 560px, 100vw' }) %></div>
      </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow"><%= t('plant.specsTitle') %></p>
      <h2 class="section-title"><%= d.specsHeading %></h2>
    </div>
    <dl class="spec-grid">
      <% d.specs.forEach((sp) => { %>
        <div class="spec reveal">
          <span class="spec__icon"><%- icon(sp.icon) %></span>
          <dt><%= sp.label %></dt>
          <dd><%= sp.value %></dd>
        </div>
      <% }) %>
    </dl>
    <p class="plant-detail__source muted"><%= d.source %></p>
  </div>
</section>

<% if (photos.length > 1) { %>
<section class="section">
  <div class="container">
    <div class="section-head section-head--row reveal">
      <div>
        <p class="eyebrow"><%= t('nav.gallery') %></p>
        <h2 class="section-title"><%= d.photosTitle %></h2>
      </div>
      <a class="link-arrow" href="<%= url('gallery') %>"><%= t('common.viewAll') %> <%- icon('arrow-right') %></a>
    </div>
    <div class="mosaic" data-lightbox data-label-close="<%= t('gallery.close') %>" data-label-prev="<%= t('gallery.prev') %>" data-label-next="<%= t('gallery.next') %>">
      <% photos.slice(1).forEach((p, i) => { const cap = d.captions[photos.indexOf(p)] || d.title; %>
        <a class="mosaic__item reveal" href="<%= h.imgUrl(p.src, 1920) %>" data-lightbox-item data-caption="<%= cap %>">
          <%- h.img(p.src, cap, { sizes: i === 0 ? '(min-width: 1024px) 600px, 100vw' : '(min-width: 1024px) 300px, 50vw', width: 640 }) %>
          <span class="gallery-grid__zoom" aria-hidden="true"><%- icon('expand') %></span>
          <span class="sr-only"><%= t('gallery.open') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% } else { %>
<section class="section plant-pending">
  <div class="container container--narrow">
    <div class="plant-pending__box reveal">
      <span class="plant-pending__icon"><%- icon('zap') %></span>
      <h2 class="section-title"><%= plant.name %></h2>
      <p class="lead"><%= t('plant.plantsPending') %></p>
      <a class="btn btn--primary" href="<%= url('plant') %>"><span><%= t('plant.plantsHeading') %></span><%- icon('arrow-right') %></a>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/foot') %>
